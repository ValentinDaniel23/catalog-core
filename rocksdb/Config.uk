config APPROCKSDB
bool "Configure RocksDB demo application"
default y
	select LIBROCKSDB
	select LIBROCKSDBTEST
	select LIBROCKSDBTEST_ALL

	# C++ runtime stack
	select LIBCOMPILER_RT
	select LIBCXX
	select LIBCXXABI
	select LIBUNWIND
	select LIBMUSL

	# Filesystem stack
	select LIBVFSCORE
	select LIBVFSCORE_AUTOMOUNT_UP
	select LIBVFSCORE_AUTOMOUNT_FB
	select LIBRAMFS
	select LIBUKCPIO
	select LIBDEVFS
	select LIBDEVFS_AUTOMOUNT
	select LIBDEVFS_DEVSTDOUT

	# Timekeeping
	select LIBUKTIME

config LIBVFSCORE_AUTOMOUNT_FB0_MP
	default "/"

config LIBVFSCORE_AUTOMOUNT_FB0_DRIVER
	default "ramfs"
