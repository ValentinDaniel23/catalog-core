# Configure RocksDB application for a build that uses initrd to pass the root
# filesystem.

config APPROCKSDB
bool "Configure RocksDB application with initrd as rootfs"
default y
	# Select RocksDB library and its main function.
	select LIBROCKSDB
	select LIBROCKSDB_MAIN_FUNCTION

	# Select C++ toolchain and runtime dependencies.
	select LIBCOMPILER_RT
	select LIBCXX
	select LIBCXXABI
	select LIBUNWIND
	select LIBMUSL

	# Select filesystem core components: vfscore, cpio, ramfs.
	select LIBVFSCORE
	select LIBVFSCORE_AUTOMOUNT_UP
	select LIBRAMFS
	select LIBUKCPIO

	# Timekeeping is commonly required by RocksDB for stats and scheduling.
	select LIBUKTIME

	# Provide /dev/stdout so RocksDB logging and printf output have a device.
	select LIBDEVFS
	select LIBDEVFS_AUTOMOUNT
	select LIBDEVFS_DEVSTDOUT
