{
  "boot-source": {
    "kernel_image_path": "workdir/build/rocksdb_fc-arm64",
    "boot_args": "rocksdb_fc-arm64 -- --storage=initrd --db=/rocksdb-demo --all-features",
    "initrd_path": "initrd.cpio"
  },
  "drives": [],
  "machine-config": {
    "vcpu_count": 1,
    "mem_size_mib": 512,
    "smt": false,
    "track_dirty_pages": false
  }
}
