CONFIG_UK_NAME="rocksdb"
CONFIG_ARCH_X86_64=y
CONFIG_PLAT_KVM=y
CONFIG_STACK_SIZE_PAGE_ORDER=6
CONFIG_LIBVFSCORE_AUTOMOUNT_ROOTFS=y
CONFIG_LIBVFSCORE_ROOTFS_INITRD=y
CONFIG_LIBUKPRINT_KLVL_INFO=y
CONFIG_APPROCKSDB=y
CONFIG_OPTIMIZE_PERF=y
CONFIG_DEBUG_SYMBOLS_LVL1=y

# Optional but useful for persistence validation over host-shared 9p.
CONFIG_LIBUK9P=y
CONFIG_LIB9PFS=y
CONFIG_LIBVIRTIO_9P=y
CONFIG_LIBVIRTIO_PCI=y
