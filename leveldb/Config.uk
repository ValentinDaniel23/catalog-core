config APPLEVELDB
bool "Configure LevelDB demo application"
default y
	select LIBLEVELDB
	select LIBMUSL

	# Filesystem: vfscore + ramfs root, populated at boot from an initrd
	# (cpio) via a user vfs.fstab, e.g. "initrd0:/:extract::ramfs=1:".
	select LIBVFSCORE
	select LIBVFSCORE_AUTOMOUNT_UP
	select LIBRAMFS
	select LIBUKCPIO

	# Wire application stdio to the serial console.
	select LIBUKFS
	select LIBUKFS_DEVFS

	# Timekeeping used by LevelDB.
	select LIBUKTIME
