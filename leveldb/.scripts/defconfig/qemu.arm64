CONFIG_PLAT_KVM=y
CONFIG_KVM_VMM_QEMU=y
CONFIG_ARCH_ARM_64=y
CONFIG_APPLEVELDB=y
CONFIG_UK_DEFNAME="leveldb"
CONFIG_UK_NAME="leveldb"

# LevelDB is C++ with deep call stacks; enlarge the stack.
CONFIG_STACK_SIZE_PAGE_ORDER=6
CONFIG_OPTIMIZE_PERF=y

# Disable ARM64 errata workarounds (not needed on virtual CPUs).
CONFIG_ARM64_ERRATUM_858921=n
CONFIG_ARM64_ERRATUM_835769=n
CONFIG_ARM64_ERRATUM_843419=n

# Uncomment for a verbose boot log (debugging).
# CONFIG_LIBUKPRINT_KLVL_INFO=y
# CONFIG_LIBUKPRINT_KLVL_DEBUG=y
